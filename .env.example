# Copy to .env and adjust. Never commit .env.

# ---- Alarm Management API (simulator) ------------------------------------------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=2
# base of the exponential backoff between retries (seconds)
ALARM_API_BACKOFF_SECONDS=0.25
# Transient fault injection for demos: first N calls per trace fail (only for listed client ids)
SIM_FAULTS=POST /alarms/correlation=503x1
SIM_FAULT_CLIENTS=alarm-mcp-server,alarm-copilot
# Optional fixed data anchor (defaults to today 00:00 UTC)
SIM_ANCHOR_TIME=
SIM_HOST=0.0.0.0
SIM_PORT=8000
# random seed of the synthetic data set
SIM_SEED=42
# artificial latency per request (ms) and the x-simulate-fault test header (disable outside demos)
SIM_LATENCY_MS=0
SIM_ALLOW_FAULT_HEADER=true

# ---- MCP server ------------------------------------------------------------------------------------
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_SERVER_TOKEN=replace-me
# Optional comma-separated allow-list of exposed tools (empty = all read-only tools)
MCP_ENABLED_TOOLS=
# Optional Host-header allow-list (enables DNS-rebinding protection), e.g. alarm-mcp:9000,localhost:9000
MCP_ALLOWED_HOSTS=
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp
# copilot-side MCP client: per-call timeout, tool-discovery cache, client id sent as trace metadata
MCP_TIMEOUT_SECONDS=30
MCP_TOOL_CACHE_SECONDS=60
MCP_CLIENT_ID=alarm-copilot

# ---- Secondary MCP server (document knowledge over the RAG index) -----------------------------
DOCS_MCP_SERVER_URL=http://docs-mcp:9100/mcp
DOCS_MCP_SERVER_TOKEN=replace-me
# build/refresh the index on first tool call (false when a separate ingestion job owns the index)
DOCS_MCP_AUTO_INGEST=true
DOCS_MCP_HOST=0.0.0.0
DOCS_MCP_PORT=9100
DOCS_MCP_PATH=/mcp
DOCS_MCP_ALLOWED_HOSTS=

# ---- LLM (optional; "offline" needs no key) ---------------------------------------------------
# offline | anthropic | openai (OpenAI-compatible via LLM_BASE_URL)
LLM_PROVIDER=offline
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# ---- RAG -------------------------------------------------------------------------------------------
DOCUMENT_PATH=./rag/documents
RAG_INDEX_PATH=./rag/retrieval/.index
# lsa (local, default) | fastembed (optional ONNX model)
EMBEDDING_PROVIDER=lsa
# build/refresh the index at backend start-up; passages returned per query; below this score = low confidence
RAG_AUTO_INGEST=true
RAG_TOP_K=5
RAG_LOW_CONFIDENCE_THRESHOLD=0.30
# the index is file-based (see docs/rag-design.md)
VECTOR_STORE_URL=not-used

# ---- Copilot backend ---------------------------------------------------------------------------
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# optional: serve the GUI from this folder (default: apps/frontend/dist, else the bundled copy)
COPILOT_GUI_DIR=
# optional fixed 'now' for reproducible demos, e.g. 2026-07-01T00:00:00Z
COPILOT_REFERENCE_TIME=
# enables POST /api/rag/reindex when set
COPILOT_ADMIN_TOKEN=
DEFAULT_LOOKBACK_DAYS=90
LOG_LEVEL=INFO
# no write operations are implemented (see docs/known-limitations.md)
TICKETING_API_URL=not-used
