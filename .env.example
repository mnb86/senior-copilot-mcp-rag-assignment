# Copy to .env and adjust. Never commit .env.

# ---- Alarm Management API (simulator) ------------------------------------------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=2
# Transient fault injection for demos: first N calls per trace fail (only for listed client ids)
SIM_FAULTS=POST /alarms/correlation=503x1
SIM_FAULT_CLIENTS=alarm-mcp-server
# Optional fixed data anchor (defaults to today 00:00 UTC)
SIM_ANCHOR_TIME=

# ---- MCP server ------------------------------------------------------------------------------------
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_SERVER_TOKEN=replace-me
# Optional comma-separated allow-list of exposed tools (empty = all read-only tools)
MCP_ENABLED_TOOLS=
# Optional Host-header allow-list (enables DNS-rebinding protection), e.g. alarm-mcp:9000,localhost:9000
MCP_ALLOWED_HOSTS=

# ---- LLM (optional; "offline" needs no key) ---------------------------------------------------
# offline | anthropic | openai (OpenAI-compatible via LLM_BASE_URL)
LLM_PROVIDER=offline
LLM_API_KEY=replace-me
LLM_MODEL=replace-me
LLM_BASE_URL=

# ---- RAG -------------------------------------------------------------------------------------------
DOCUMENT_PATH=./rag/documents
RAG_INDEX_PATH=./.rag_index
# lsa (local, default) | fastembed (optional ONNX model)
EMBEDDING_PROVIDER=lsa
# the index is file-based (see docs/rag-design.md)
VECTOR_STORE_URL=not-used

# ---- Copilot backend ---------------------------------------------------------------------------
# enables POST /api/rag/reindex when set
COPILOT_ADMIN_TOKEN=
DEFAULT_LOOKBACK_DAYS=90
LOG_LEVEL=INFO
# no write operations are implemented (see docs/known-limitations.md)
TICKETING_API_URL=not-used
